{
    "name": "rkistaps/cron-manager",
    "description": "Define cron jobs in PHP and keep a marked block of the system crontab in sync.",
    "type": "library",
    "license": "MIT",
    "keywords": ["cron", "crontab", "scheduler", "jobs"],
    "authors": [
        {
            "name": "Kristaps Taube",
            "email": "kristaps.taube@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/log": "^3.0",
        "dragonmantank/cron-expression": "^3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "rkistaps/the-app": "^1.0",
        "php-di/php-di": "^7.0",
        "league/climate": "^3.8"
    },
    "suggest": {
        "rkistaps/the-app": "Registers the cron/* commands on the-app's CommandRunner",
        "league/climate": "Console output for the cron/* commands"
    },
    "autoload": {
        "psr-4": {
            "rkistaps\\CronManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "rkistaps\\CronManager\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
